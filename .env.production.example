IMAGE_TAG=latest
APP_URL=https://songgate.app
SENTRY_DSN=
PUBLIC_SENTRY_DSN=
POSTGRES_PASSWORD=CHANGE_ME
# Memory limit of Postgres, default 512m
POSTGRES_MEMORY=
# Feedback mails, through noreply@pleasance.org (Proton SMTP token)
SMTP_HOST=smtp.protonmail.ch
SMTP_PORT=587
SMTP_USER=noreply@pleasance.org
SMTP_PASS=CHANGE_ME
EMAIL_FROM=Songgate <noreply@pleasance.org>
FEEDBACK_EMAIL=
# App builds below these build numbers are asked to update (CI run number, AGENTS.md "Deploy")
MIN_BUILD_IOS=
MIN_BUILD_ANDROID=

# MusicKit key for the Apple Music API: matches Apple Music and Deezer by ISRC.
# Without it Apple Music is matched by title and artist through the iTunes API.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_KEY_BASE64=
