# Local dev. Copy to .env, then: docker compose up -d && bun run dev
DATABASE_URL=postgresql://app:app@localhost:5439/app
# Links in /llms.txt
APP_URL=http://localhost:5173

# Optional. Without SMTP_HOST feedback mails are printed to the API log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
FEEDBACK_EMAIL=

# Optional. App builds below these build numbers are asked to update (CI run number).
MIN_BUILD_IOS=
MIN_BUILD_ANDROID=

# Optional. MusicKit key for the Apple Music API: matches Apple Music and Deezer by ISRC.
# Without it Apple Music is matched by title and artist through the iTunes API.
APPLE_MUSIC_TEAM_ID=
APPLE_MUSIC_KEY_ID=
APPLE_MUSIC_KEY_BASE64=

# Optional. App of the TIDAL developer portal (client credentials): finds songs and albums on TIDAL.
# Without it TIDAL links are read from their pages and TIDAL only gets a search link.
TIDAL_CLIENT_ID=
TIDAL_CLIENT_SECRET=

# Optional. App of the Spotify developer dashboard (client credentials): finds podcasts on Spotify.
# Without it Spotify links are still read from their pages, podcasts on Spotify only get a search link.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
