{
  "name": "musiclink",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "apps/*"],
  "scripts": {
    "dev": "bun run --filter './apps/*' dev",
    "check": "biome lint && bun run --filter '*' check",
    "test": "bun run --filter '*' test",
    "build": "bun run --filter '*' build"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "^6.0.3",
    "@biomejs/biome": "^2.5.15"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.25.12"
    }
  }
}
